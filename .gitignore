# credentials — never tracked (rule #9)
.env

# venv & caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.cache/

# bulk data: gitignored. Small weekly outputs/ledger CSVs ARE committed
# (rule #10) — do not add data/outputs/ or data/ledger/ here.
data/research/cache/
data/research/.golden_run/

# Weekly roster reports. These name the owner's actual players, week by week,
# so they stay on the owner's disk: regenerable from the cache in one command,
# and not worth putting in a repo that people other than the owner can read.
# `weekly_report_latest.*` is additionally the stable path golden_run.py A/Bs,
# rewritten on every run.
data/outputs/week*_report.md
data/outputs/week*_report.csv
data/outputs/weekly_report_latest.md
data/outputs/weekly_report_latest.csv

# The decision dashboard and the decision-time archive name the owner's
# players and lineup: local files, regenerable from the cache in one command.
data/outputs/dashboard/
data/ledger/decisions/

# research-agent scratch drafts (synthesized into docs/research/*.md)
docs/research/drafts/

# The scenario runner writes its synthetic caches and rendered pages next to
# the committed review screenshots. Only the PNGs belong in the repo: the
# caches are regenerable fixtures, and a rendered page is a roster artifact
# by shape even when the roster inside it is invented — keeping the rule
# mechanical is what stops a real cache being published by an out-dir typo.
docs/review/dashboard/caches/
docs/review/dashboard/*/
docs/review/gameday/caches/
docs/review/gameday/*/
# committed review evidence: pregame*, stale*, mixed*, injury_after* PNGs and the two drive logs
docs/review/gameday/conflict*.png
docs/review/gameday/custom*.png
docs/review/gameday/empty*.png
docs/review/gameday/no_archive*.png
docs/review/gameday/rollover*.png
docs/review/gameday/pregame_stale*.png

# Cloud carryover store (private decision records restored from a cache)
.carry/
