# Copy to .env (gitignored) and fill in. All settings read via
# gridiron.config.get_settings(); prefix is GRIDIRON_.

# ESPN league auth (only if the league ever moves to ESPN; nothing reads
# these today): cookies from a logged-in browser session — SWID and espn_s2,
# plus the numeric league id from the URL.
GRIDIRON_ESPN_LEAGUE_ID=
GRIDIRON_ESPN_S2=
GRIDIRON_ESPN_SWID=

# Sleeper (if PLATFORM == "sleeper"): no auth needed, just the league id.
GRIDIRON_SLEEPER_LEAGUE_ID=

# The Odds API (free plan, the-odds-api.com): player props for the record-only
# market contender (docs/research/PROPS_COLLECTOR.md). Also an Actions secret of
# the same name, beside GRIDIRON_ODDS_ARCHIVE_KEY (a secret only, never here).
GRIDIRON_ODDS_API_KEY=
